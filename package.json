{
  "name": "godpower-html",
  "version": "2.18.14",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/unit/*.test.mjs tests/integration/*.test.mjs",
    "test:e2e": "node tests/e2e/run.mjs && node tests/e2e/rules.mjs",
    "verify": "npm run build && npm run check && npm test && npm run test:e2e",
    "audit": "node scripts/audit.mjs",
    "test:visual": "node tests/e2e/visual.mjs",
    "report": "python3 scripts/report.py",
    "test:file": "node tests/e2e/file.mjs"
  },
  "devDependencies": {
    "acorn": "8.15.0",
    "playwright": "1.56.1"
  }
}
